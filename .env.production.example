# Server .env for docker compose (never commit real values).

DOMAIN=levbarber.ua
CERTBOT_EMAIL=you@example.com

# Baked into the Next build (not a runtime override). Must match the public HTTPS
# origin (no trailing slash). Changing this requires rebuilding the frontend image.
NEXT_PUBLIC_SITE_URL=https://levbarber.ua

# Optional: comma-separated extra Origins allowed for POST /api/career (absolute URLs).
# Production never trusts Host / X-Forwarded-Host — only NEXT_PUBLIC_SITE_URL + this list.
# CAREER_ALLOWED_ORIGINS=https://staging.example.com

# TRUST_PROXY is set to 1 in docker-compose.prod.yml (nginx overwrites client IP headers).
# Do not enable it for a bare `next start` exposed to the internet.

# Career form → Telegram (required for compose up; app also fails startup if empty)
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Production images (CI writes these into .env.release by digest).
# For bootstrap before first CI deploy, use local tags with docker-compose.prod.build.yml:
#   FRONTEND_IMAGE=barber-frontend:local
#   NGINX_IMAGE=barber-nginx:local
FRONTEND_IMAGE=
NGINX_IMAGE=
